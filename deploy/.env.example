# Sawazi server settings. Copy to deploy/.env and fill in. Never commit deploy/.env.
# Make each secret with:  openssl rand -hex 32

# ---- required
# The address staff, members and callbacks use. Point its DNS A record at this server first.
# Use "localhost" only to try the kit on your own computer.
SAWAZI_DOMAIN=sawazi.example.co.ke
POSTGRES_PASSWORD=
# Platform key: only for creating an institution and its first admin. Keep it offline after that.
SAWAZI_API_KEY=

# ---- SMS (Taifa Mobile). Leave the provider as "simulate" until Taifa has confirmed the account (pilot checklist 4).
SAWAZI_SMS_PROVIDER=simulate
# SAWAZI_TAIFA_URL=          only if Taifa gives you a different v2 send URL
# Taifa Mobile API v2 key (SAWAZI_TAIFA_API_KEY is still read as a fallback).
TAIFA_API_KEY=
# SAWAZI_TAIFA_API_KEY=
# Sender used when the institution has no SMS service name; SIDNET is the only approved one today.
TAIFA_SENDER_ID=SIDNET
SAWAZI_SMS_CALLBACK_TOKEN=
# Taifa's sending addresses. Callbacks from anywhere else are refused (an empty list refuses all).
SAWAZI_SMS_ALLOWED_IPS=

# ---- M-Pesa Daraja C2B (pilot checklist 6). Callbacks need this token AND a Safaricom address on the list.
SAWAZI_DARAJA_ENV=sandbox
SAWAZI_DARAJA_CALLBACK_TOKEN=
SAWAZI_DARAJA_ALLOWED_IPS=

# ---- USSD guarantor consent via Taifa (pilot checklist 5)
SAWAZI_USSD_CALLBACK_TOKEN=
SAWAZI_USSD_CODE=
SAWAZI_USSD_SHORTCUT=
SAWAZI_USSD_ALLOWED_IPS=

# ---- optional
# SAWAZI_CALLBACKS_OPEN=1    sandbox or local trial only: accept callbacks while an allow-list is empty
# SAWAZI_WORKERS=2          API worker processes (2 suits a 2 GB server)
# SAWAZI_MIGRATE_ON_START=1 0 = never migrate at start-up (Vercel never does; it runs alembic once per release)
# SAWAZI_OTP_DAILY_CAP=500   member sign-in SMS across all members per day (a guard against SMS-bill abuse)
# BACKUP_AT=01:30           daily backup time, Nairobi time
# BACKUP_KEEP_DAYS=14
# BACKUP_DIR=./backups

# Nightly job (sawazi/cron.py): rebuilds every collections queue before work starts. Any long random string.
# Then add to the host's crontab:  0 3 * * * curl -fsS -H "Authorization: Bearer $SAWAZI_CRON_SECRET" https://YOUR_DOMAIN/cron/daily
# (on Vercel set CRON_SECRET instead; vercel.json already schedules it)
SAWAZI_CRON_SECRET=
